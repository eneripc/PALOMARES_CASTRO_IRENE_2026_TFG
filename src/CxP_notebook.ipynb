    "\n",
    "\n",
    "df_ts[\"Registrado2\"] = pd.to_datetime(df_ts[\"Registrado\"], errors=\"coerce\")\n",
    "df_ts[\"periodo\"] = df_ts[\"Registrado2\"].dt.to_period(\"M\")\n",
