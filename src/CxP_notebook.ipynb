    "df_ts, df_casos,df_anticipos, df_zs, df_dup, df_if, df_rg, df_cluster, stats_cluster, df_rf, df_cls, stats_global, proveedores_kpis, analisis_ue, clust_proveedores = run_pipeline(df_ts)"
