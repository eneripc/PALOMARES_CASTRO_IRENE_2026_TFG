   "source": [
    "# ============================================================\n",
    "# CELDA 24. PICOS DE VARIABLES FORECAST\n",
    "# ============================================================\n",
    "\n",
    "fecha_col = \"periodo_dt\"\n",
    "\n",
    "vars_forecast = [\n",
    "    \"Antigüedad_forecast\",\n",
    "    \"Demora_forecast\",\n",
    "    \"ImpteML_forecast\",\n",
    "    \"n_facturas_forecast\",\n",
    "    \"pct_anomalias_forecast\",\n",
    "    \"Riesgo_final_rf_forecast\"\n",
    "]\n",
    "\n",
    "df_final[df_final[\"UE\"] != \"GLOBAL\"]\n",
    "for var in vars_forecast:\n",
