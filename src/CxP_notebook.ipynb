    "    \"corr\": np.corrcoef(y_true_b, y_pred_b)[0,1] if len(y_true_b) > 1 else np.nan\n",
    "}]).round(4)\n",
    "\n",
    "print(\"Evaluación regressor (Bávaro)\")\n",
    "display(eval_reg_b)"
   ]
