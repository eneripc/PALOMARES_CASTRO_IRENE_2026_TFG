   "source": [
    "# CELDA 17. AGREGACIÓN TEMPORAL\n",
    "\n",
    "df_res = (\n",
    "    df_ts.set_index(fecha_col)\n",
    "         .groupby([\"UE\", \"Cuenta\"])\n",
    "         .resample(\"MS\")\n",
    "         .agg({\n",
    "             \"ImpteML\": \"sum\",\n",
    "             \"Outlier\": \"sum\",\n",
    "             \"Riesgo_final\": \"mean\",\n",
    "             \"Antigüedad\": \"mean\",\n",
    "             \"Demora\": \"mean\",\n",
    "         })\n",
    "         .reset_index()\n",
    ")\n",
    "\n",
    "df_res[\"n_facturas\"] = (\n",
    "    df_ts.set_index(fecha_col)\n",
    "         .groupby([\"UE\", \"Cuenta\"])\n",
    "         .resample(\"MS\")\n",
    "         .size()\n",
    "         .values\n",
    ")\n",
    "\n",
    "df_res[\"pct_anomalias\"] = df_res[\"Outlier\"] / df_res[\"n_facturas\"]\n",
    "\n",
    "df_res[\"pct_anomalias\"].replace([np.inf, -np.inf], 0, inplace=True)\n"
   ]
  },
