   "source": [
    "resumen_comunes = (\n",
    "    df_proveedores_comunes\n",
    "    .groupby([\"Cuenta\", \"UE\"])\n",
    "    .agg({\n",
    "        \"ImpteML\": \"sum\",\n",
    "        \"Riesgo_final\": \"mean\"\n",
    "    })\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "display(resumen_comunes.head(20))"
   ]
