    "    steps_test=6,\n",
    "    steps_future=12,\n",
    "    plot_diagnostico=False,\n",
    "    plot_forecast=False\n",
    ")\n",
    "\n",
    "vars_7 = [\n",
    "    \"ImpteML\", \"n_facturas\", \"pct_anomalias\",\n",
    "    \"Antigüedad\", \"Demora\"\n",
    "]\n",
    "\n",
    "print(\"\\nPredicciones finales\")\n",
    "\n",
    "for ue in ['Maya', 'Bavaro']:\n",
    "    print(f\"\\nUE: {ue}\")\n",
    "    df_ue = df_final[df_final[\"UE\"] == ue]\n",
